#requires -version 5.1

[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

$DataDirectory = Join-Path `
    $env:ProgramData `
    'Corporate\UptimeReboot'

try {

    if (Test-Path -LiteralPath $DataDirectory) {

        Remove-Item `
            -LiteralPath $DataDirectory `
            -Recurse `
            -Force `
            -ErrorAction Stop
    }

    exit 0

}
catch {

    Write-Error (
        "Unable to remove UptimeReboot data: $($_.Exception.Message)"
    )

    exit 1
}
