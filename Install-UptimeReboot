#requires -version 5.1

<#
.SYNOPSIS
    Requests a Configuration Manager managed restart when the device
    reaches the configured uptime threshold.

.DESCRIPTION
    Lab configuration:
        Uptime threshold: 60 minutes.

    Exit codes:
        0  = Success, restart not required.
        10 = Success, soft restart required.
        1  = Execution failure.

    This script does NOT directly restart the device.
    Configuration Manager is responsible for restart notifications,
    countdown, and restart enforcement.

.NOTES
    Expected execution context: LocalSystem
    Minimum PowerShell version: Windows PowerShell 5.1
#>

[CmdletBinding()]
param(
    [ValidateRange(1, 525600)]
    [int]$MaximumUptimeMinutes = 60
)

Set-StrictMode -Version 2.0
$ErrorActionPreference = 'Stop'

# ============================================================
# CONFIGURATION
# ============================================================

$LogDirectory = Join-Path `
    -Path $env:ProgramData `
    -ChildPath 'Corporate\UptimeReboot'

$LogFile = Join-Path `
    -Path $LogDirectory `
    -ChildPath 'UptimeReboot.log'


# ============================================================
# LOGGING
# ============================================================

function Write-UptimeLog {

    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet(
            'INFO',
            'WARNING',
            'ERROR'
        )]
        [string]$Level = 'INFO'
    )

    try {

        if (-not (Test-Path -LiteralPath $LogDirectory)) {

            New-Item `
                -Path $LogDirectory `
                -ItemType Directory `
                -Force `
                -ErrorAction Stop |
                Out-Null
        }

        $Timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'

        $LogEntry = '{0} [{1}] {2}' -f `
            $Timestamp,
            $Level,
            $Message

        Add-Content `
            -LiteralPath $LogFile `
            -Value $LogEntry `
            -Encoding UTF8 `
            -ErrorAction Stop
    }
    catch {

        # Logging failures must not change the operational result.
    }
}


# ============================================================
# MAIN
# ============================================================

try {

    Write-UptimeLog `
        -Message 'Starting uptime evaluation.'


    # Get operating system information.

    $OperatingSystem = Get-CimInstance `
        -ClassName Win32_OperatingSystem `
        -ErrorAction Stop


    if ($null -eq $OperatingSystem) {

        throw 'Win32_OperatingSystem returned null.'
    }


    $LastBootTime = $OperatingSystem.LastBootUpTime


    if ($null -eq $LastBootTime) {

        throw 'LastBootUpTime returned null.'
    }


    # Calculate device uptime.

    $CurrentTime = Get-Date

    $Uptime = $CurrentTime - $LastBootTime


    if ($Uptime.TotalMinutes -lt 0) {

        throw 'Calculated uptime is negative. Check the system date and time.'
    }


    $UptimeMinutes = [math]::Floor(
        $Uptime.TotalMinutes
    )

    $UptimeHours = [math]::Round(
        $Uptime.TotalHours,
        2
    )


    # Record the evaluation results.

    Write-UptimeLog `
        -Message (
            'Computer={0}; LastBoot={1}; CurrentTime={2}; UptimeMinutes={3}; UptimeHours={4}; ThresholdMinutes={5}' -f `
            $env:COMPUTERNAME,
            $LastBootTime,
            $CurrentTime,
            $UptimeMinutes,
            $UptimeHours,
            $MaximumUptimeMinutes
        )


    # Device has not reached the uptime threshold.

    if ($UptimeMinutes -lt $MaximumUptimeMinutes) {

        Write-UptimeLog `
            -Message (
                'Threshold not reached. Uptime={0} minutes; Threshold={1} minutes. No restart requested.' -f `
                $UptimeMinutes,
                $MaximumUptimeMinutes
            )

        exit 0
    }


    # Device has reached or exceeded the uptime threshold.

    Write-UptimeLog `
        -Message (
            'Threshold reached. Uptime={0} minutes; Threshold={1} minutes. Requesting Configuration Manager managed restart.' -f `
            $UptimeMinutes,
            $MaximumUptimeMinutes
        ) `
        -Level 'WARNING'


    # Custom Configuration Manager return code.
    #
    # Configure Return Code 10 in the Deployment Type as:
    #
    #     Code Type: Soft Reboot
    #
    # Configuration Manager will control the restart experience.

    exit 10
}
catch {

    $ErrorMessage = $_.Exception.Message

    Write-UptimeLog `
        -Message (
            'Uptime evaluation failed. Error={0}' -f `
            $ErrorMessage
        ) `
        -Level 'ERROR'

    exit 1
}
